* text=auto

# Source and configuration files stay LF across platforms.
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.cs text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# Keep command scripts LF too. cmd.exe handles LF and this avoids needless
# working-tree conversions on this repository.
*.bat text eol=lf
*.cmd text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
